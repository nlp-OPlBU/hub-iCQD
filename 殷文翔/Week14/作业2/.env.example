# 配置结构示例；服务地址来自环境文档或规划默认值，尚未实测。
# 密钥留空，由服务器本地 .env 填写。相对路径后续统一按项目根目录解析。
APP_HOST=127.0.0.1
APP_PORT=8001
DATA_DIR=./data
LOG_DIR=./logs

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=multimodal_rag
MYSQL_USER=rag_app
MYSQL_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PDF_TOPIC=multimodal-rag.pdf.parse
KAFKA_FAILED_TOPIC=multimodal-rag.pdf.failed
KAFKA_CONSUMER_GROUP=multimodal-rag-pdf-workers

# Redis 端口、认证、数据库编号需要在服务器确认；键必须使用项目专属前缀。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=multimodal-rag:

# ES 认证和 TLS 方式需要在服务器确认。
ES_URL=http://localhost:9200
ES_INDEX=multimodal-rag-chunks-v1
ES_USERNAME=
ES_PASSWORD=
ES_CA_CERTS=
ES_ANALYZER=standard

LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=models/Qwen3.5-0.8B/
# EMPTY 仅适用于文档中的未启用 API key 的 vLLM；以实际配置为准。
# 图片能力实测通过后再开启。
LLM_VISION_ENABLED=false

MINERU_COMMAND=mineru-kit
MINERU_WORKING_DIR=/workspace
MINERU_TIER=advanced
MINERU_TIMEOUT_SECONDS=1800
MINERU_MAX_CONCURRENCY=1

# 环境未提供 Embedding 服务；首版规划 BM25，不生成伪向量。
RETRIEVAL_MODE=bm25
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# 浏览器通过 Nginx 访问同源 API。
VITE_API_BASE_URL=/api
