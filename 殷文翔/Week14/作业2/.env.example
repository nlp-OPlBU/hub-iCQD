# 配置结构示例；服务地址来自环境文档或规划默认值，尚未实测。
# 密钥留空，由服务器本地 .env 填写。相对路径统一按项目根目录解析。
APP_NAME=Multimodal RAG
APP_HOST=127.0.0.1
APP_PORT=8001
APP_DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=[]
DATA_DIR=./data
LOG_DIR=./logs

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=multimodal_rag
MYSQL_USER=rag_app
MYSQL_PASSWORD=
MYSQL_CONNECT_TIMEOUT_SECONDS=3
MYSQL_POOL_SIZE=5
MYSQL_POOL_RECYCLE_SECONDS=1800

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PDF_TOPIC=multimodal-rag.pdf.parse
KAFKA_FAILED_TOPIC=multimodal-rag.pdf.failed
KAFKA_CONSUMER_GROUP=multimodal-rag-pdf-workers
KAFKA_MAX_POLL_INTERVAL_MS=3600000
# 等待 broker 确认与 worker 单次 poll 超时（秒）。
KAFKA_PUBLISH_TIMEOUT_SECONDS=10
KAFKA_CONSUMER_POLL_SECONDS=1

# Redis 端口、认证、数据库编号需要在服务器确认；键必须使用项目专属前缀。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=multimodal-rag:
REDIS_CACHE_TTL_SECONDS=60

# ES 认证和 TLS 方式需要在服务器确认。
ES_URL=http://localhost:9200
ES_INDEX=multimodal-rag-chunks-v1
ES_USERNAME=
ES_PASSWORD=
ES_CA_CERTS=
ES_ANALYZER=standard
ES_TIMEOUT_SECONDS=30
ES_BULK_BATCH_SIZE=200

# 全本地模型部署规划见 docs/models.md；8100 等端口不是已经运行的服务。
LLM_BASE_URL=http://127.0.0.1:8100/v1
LLM_API_KEY=EMPTY
LLM_MODEL=rag-vlm
# EMPTY 仅适用于绑定本机且未启用 API key 的 vLLM；以实际配置为准。
# 图片能力实测通过后再开启。
LLM_VISION_ENABLED=false
LLM_TIMEOUT_SECONDS=120

# 服务器项目路径示例；CLI 来自系统 conda 环境 py312，部署环境不同时覆盖。
MINERU_COMMAND=/usr/local/miniconda3/envs/py312/bin/mineru-kit
MINERU_WORKING_DIR=/workspace/multimodal-rag
MINERU_HOME=/workspace/multimodal-rag/mineru
MINERU_CONFIG=/workspace/multimodal-rag/mineru/config.yaml
# Worker 向子进程传递 MINERU_HOME / MINERU_CONFIG；8104 端点在该 YAML 配置。
# CLI cwd 为每次租约独立目录；MINERU_WORKING_DIR 仅保留兼容旧配置。
MINERU_TIER=advanced
MINERU_TIMEOUT_SECONDS=1800
MINERU_MAX_CONCURRENCY=1

# 已选型但未部署验证；保留 BM25，验证图文向量、ES mapping 与过滤后切换 hybrid。
RETRIEVAL_MODE=bm25
EMBEDDING_BASE_URL=http://127.0.0.1:8102/v1
EMBEDDING_API_KEY=EMPTY
EMBEDDING_MODEL=rag-embedding
EMBEDDING_DIMENSIONS=2048

# 重排客户端尚未实现；此处为配置约定，不能作为功能已可用的证明。
# BASE_URL 不带 /v1；客户端根据实际版本请求 /score 或 /rerank。
RERANK_BASE_URL=http://127.0.0.1:8103
RERANK_API_KEY=EMPTY
RERANK_MODEL=rag-reranker
RERANK_ENABLED=false

# 浏览器通过 Nginx 访问同源 API。
VITE_API_BASE_URL=/api
# 仅 Vite 开发代理使用；生产环境由 Nginx 转发。
VITE_DEV_API_TARGET=http://127.0.0.1:8001

# 以下为统一限制契约；上传/解压/Worker/模型适配实现时必须实际执行这些限制。
# 字节数包含请求 multipart 开销；单文件与整个请求上限分别控制。
UPLOAD_MAX_FILES=10
UPLOAD_MAX_FILE_BYTES=52428800
UPLOAD_MAX_REQUEST_BYTES=209715200
ZIP_MAX_ENTRIES=10000
ZIP_MAX_ENTRY_BYTES=104857600
ZIP_MAX_UNCOMPRESSED_BYTES=1073741824
ZIP_MAX_COMPRESSION_RATIO=100

# MAX_RETRIES 不包含首次尝试：3 次重试最多实际执行 4 次。
TASK_MAX_RETRIES=3
TASK_RETRY_BASE_SECONDS=5
TASK_RETRY_MAX_SECONDS=300
# 租约靠心跳续约，不要求大于整个解析耗时；旧租约令牌不得提交结果。
TASK_LEASE_SECONDS=120
TASK_HEARTBEAT_SECONDS=30
OUTBOX_MAX_RETRIES=10
OUTBOX_LEASE_SECONDS=60
OUTBOX_POLL_SECONDS=1
OUTBOX_BATCH_SIZE=20

# 上下文图片总数含用户原图和检索图片；原图内容必须实际发送给视觉模型。
IMAGE_MAX_UPLOAD_FILES=4
IMAGE_MAX_FILE_BYTES=10485760
IMAGE_MAX_PIXELS=20000000
IMAGE_MAX_EDGE=2048
IMAGE_MAX_CONTEXT_COUNT=8
IMAGE_MAX_CONTEXT_BYTES=20971520
IMAGE_TOKEN_BUDGET=4096
RAG_CONTEXT_TOKEN_BUDGET=12000
LLM_MAX_OUTPUT_TOKENS=2048
