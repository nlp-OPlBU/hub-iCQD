# 复制为 .env 并填入自己的 DeepSeek Key；.env 不要提交到仓库
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 没有 key 或想离线演示时打开（不调用任何外部接口）
# MOCK=1

# 可选：端口与下游地址，改了端口记得同步改 URL
# SENTIMENT_PORT=8201
# RESPONSE_PORT=8202
# BACKEND_PORT=8200
# SENTIMENT_URL=http://127.0.0.1:8201
# RESPONSE_URL=http://127.0.0.1:8202
# BACKEND_URL=http://127.0.0.1:8200
