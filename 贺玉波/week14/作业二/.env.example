# 复制为 .env 后填写真实凭据；.env 不入库
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8080
CORS_ORIGINS=["http://localhost:5173"]

# 缺失 MYSQL__PASSWORD 时进程会 fail fast
MYSQL__HOST=127.0.0.1
MYSQL__PORT=3306
MYSQL__USER=root
MYSQL__PASSWORD=
MYSQL__DATABASE=rag

REDIS__HOST=127.0.0.1
REDIS__PORT=6379
REDIS__DB=0

KAFKA__BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA__TOPIC=doc.ingest
KAFKA__DLQ_TOPIC=doc.ingest.dlq
KAFKA__GROUP_ID=rag-ingest-worker-v1
KAFKA__PARTITIONS=1
KAFKA__RETENTION_MS=259200000
KAFKA__DLQ_RETENTION_MS=604800000

MILVUS__URI=http://127.0.0.1:19530
# 部署形态：`python -m milvus_lite server --data-dir data/milvus/rag.db --port 19530`
# 让 api 与 worker 共享同一个向量库；写本地 .db 文件则只有单进程能用（测试用）
MILVUS__TEXT_DIM=1024
MILVUS__IMAGE_DIM=512

# 向量模型：cuda 会与 vLLM 共用显卡，vLLM 占用率已降到 0.72 留出空间；
# 没有可用 GPU 时会自动降级 cpu（只打 warning，链路不中断）
# 模型可以用 HF id，也可以指向魔搭预下载后的本地目录（推荐，切换 GPU 实例时不必再下载）
EMBED__MODEL=Qwen/Qwen3-Embedding-0.6B
# EMBED__MODEL=/workspace/week14/models/Qwen3-Embedding-0.6B
EMBED__DEVICE=cuda
EMBED__BATCH_SIZE=16
EMBED__DIM=1024
EMBED__HF_ENDPOINT=https://hf-mirror.com

CLIP__MODEL=OFA-Sys/chinese-clip-vit-base-patch16
# CLIP__MODEL=/workspace/week14/models/chinese-clip-vit-base-patch16
CLIP__DEVICE=cuda
CLIP__DIM=512

# 检索链路：向量召回（文本+图片）→ BM25 词法召回 → RRF → 交叉编码器重排序 → 分数门控
# 召回宽度故意开得比最终条数宽，重排序才有得挑
RETRIEVAL__TEXT_TOP_K=20
RETRIEVAL__IMAGE_TOP_K=8
RETRIEVAL__BM25_TOP_K=20
RETRIEVAL__RRF_K=60
RETRIEVAL__FINAL_TOP_K=6

# 重排序模型：首次运行会下载约 2.3GB；可预下载到本地目录后改用路径，省去每次换实例重下
# huggingface-cli download BAAI/bge-reranker-v2-m3 --local-dir models/bge-reranker-v2-m3
RETRIEVAL__RERANK_ENABLED=true
RETRIEVAL__RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RETRIEVAL__RERANK_MODEL=models/bge-reranker-v2-m3
RETRIEVAL__RERANK_DEVICE=cuda
RETRIEVAL__RERANK_TOP_N=30
RETRIEVAL__RERANK_BATCH_SIZE=16
RETRIEVAL__RERANK_MAX_LENGTH=512

# 分数门控：低于 max(最高分×比例, 绝对下限) 的候选直接不进上下文
RETRIEVAL__GATE_RATIO=0.30
RETRIEVAL__GATE_ABS_MIN=0.05

# 短问题条件式改写：只改检索用的 query，超时/失败自动用原问题
RETRIEVAL__REWRITE_ENABLED=true
RETRIEVAL__REWRITE_MAX_CHARS=12
RETRIEVAL__REWRITE_TIMEOUT=3

# 会话上下文：历史按 token 预算裁剪，超预算后由后台滚动摘要压缩
CHAT__HISTORY_TOKEN_BUDGET=1500
CHAT__SUMMARY_TRIGGER_TOKENS=3000
CHAT__SUMMARY_KEEP_MESSAGES=6
CHAT__SUMMARY_MAX_CHARS=800

# 对话模型：local = 本地 vLLM（作业要求、离线可用）；cloud = 云端 OpenAI 兼容 API（更快更强、不占显存）
# 切到 cloud 后不需要启动 vLLM，up.sh 会自动跳过
VLLM__PROVIDER=local
VLLM__BASE_URL=http://127.0.0.1:8000/v1
VLLM__MODEL=qwen2.5-vl-7b
# VLLM__PROVIDER=cloud
# VLLM__BASE_URL=https://api.deepseek.com/v1
# VLLM__MODEL=deepseek-flash
# VLLM__API_KEY=sk-xxx
VLLM__MAX_TOKENS=1024
VLLM__TIMEOUT=120
# 每轮最多把几张命中图片编码进 prompt（云端视觉模型需要），0 = 只给文本
VLLM__MAX_IMAGES=3
# 云端 DeepSeek 默认开思考模式，会把 max_tokens 全烧在 reasoning 上导致 content 为空
VLLM__THINKING=disabled

MINERU__BIN=mineru
# MinerU 4.x 档位：flash 本地轻量解析（快、无 parse-server）；standard/advanced 需要
# `mineru server` 起来（内部跑 vLLM，显存 >= 8GB），环境不稳时别用
MINERU__TIER=flash
# cpu 稳定；切云端对话模型后显存空出来，可改 cuda 加速（约 2-4GB 显存）
MINERU__DEVICE=cpu
# MINERU__DEVICE=cuda
MINERU__MODEL_SOURCE=modelscope
MINERU__TIMEOUT=3600
MINERU__MAX_PAGES=1000
MINERU__CHUNK_SIZE=800
MINERU__CHUNK_OVERLAP=100
MINERU__MAX_ATTEMPTS=3

STORAGE__MAX_UPLOAD_MB=200
STORAGE__MAX_FILES_PER_REQUEST=20

TRACE__SLOW_NODE_MS=2000
