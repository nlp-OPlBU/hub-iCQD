# 复制为 .env，仅在后端配置。密钥与 Base URL 必须属于同一地域/业务空间。
DASHSCOPE_API_KEY=
# 按百炼控制台填写，将 {WorkspaceId} 替换为真实业务空间 ID。
OPENAI_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-plus
SQL_MODEL=qwen-plus
MODEL_TIMEOUT=60
QWEN_DISABLE_THINKING=true
# 仅在所选视觉模型明确支持 JSON Mode 时改为 true；默认使用提示词 + 严格校验。
VISION_JSON_MODE=false
