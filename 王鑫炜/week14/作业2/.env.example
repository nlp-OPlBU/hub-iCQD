REDIS_URL=redis://127.0.0.1:16379/0
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
KAFKA_TOPIC=wxw14.pdf.parse
KAFKA_GROUP=wxw14-mineru
DATA_DIR=./runtime
# cli: local MinerU; api: independently deployed MinerU HTTP service
MINERU_MODE=cli
MINERU_API_URL=http://host.docker.internal:8015
MINERU_BACKEND=pipeline
MINERU_DEVICE=cpu
MINERU_MODEL_SOURCE=modelscope
MINERU_FORMULA_ENABLE=false
MINERU_TABLE_ENABLE=false
PARSE_TIMEOUT=900
# OpenAI-compatible vision model, no silent offline fallback
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_ENABLE_THINKING=false
CHAT_TTL_SECONDS=604800
