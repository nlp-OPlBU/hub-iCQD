# ===== 模型网关（必填）=====
# 任意 OpenAI 兼容的视觉模型网关，地址写到 /v1 为止
OPENAI_BASE_URL=https://your-gateway.example.com/v1
OPENAI_API_KEY=sk-your-key-here

# 模型列表：id|界面显示名，用英文逗号分隔；id 按网关实际模型名填写
MODELS=ds-flash-4.1|DS Flash 4.1,qwen-vl-max|Qwen-VL-Max
DEFAULT_MODEL=ds-flash-4.1

# ===== 可选参数 =====
# 单次请求超时（秒）
REQUEST_TIMEOUT=120
# 网关支持 response_format=json_object 时可置 1，输出更稳定
JSON_MODE=0
MAX_UPLOAD_MB=12
# 送入模型前的最长边，过小会看不清堆积物细节
MAX_IMAGE_SIDE=1280
# 部分网关有 Cloudflare 校验，需要浏览器 UA；留空则使用默认 UA
HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36
HOST=127.0.0.1
PORT=8000
