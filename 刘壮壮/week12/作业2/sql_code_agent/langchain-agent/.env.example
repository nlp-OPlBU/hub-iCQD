# deepseek（默认）或 openai
SQL_AGENT_PROVIDER=deepseek

# 必填；请填写当前 Provider 可用的模型名
SQL_AGENT_MODEL=

# 相对于 openai-agent 项目目录解析；留空时使用 ../data/chinook.db
SQL_AGENT_DB_PATH=
SQL_AGENT_MAX_REWRITES=2
SQL_AGENT_MAX_RESULT_ROWS=100
SQL_AGENT_MAX_PROGRESS_STEPS=1000000
SQL_AGENT_MODEL_TIMEOUT_SECONDS=60
SQL_AGENT_MODEL_MAX_RETRIES=1

DEEPSEEK_API_KEY=
SQL_AGENT_BASE_URL=https://api.deepseek.com

# SQL_AGENT_PROVIDER=openai 时使用
OPENAI_API_KEY=

# LangSmith tracing；开启后问题、Schema 样本和查询结果会发送到 LangSmith
# 不要同时设置 LANGSMITH_PROJECT，否则 SDK 会因目标冲突而不上报 trace
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=sql-agent-lc
LANGSMITH_AGENT_ENVIRONMENT=local
