# ==============================================================================
# Multimodal RAG 环境变量配置示例
# 使用方式：复制本文件为 .env（cp .env.example .env），再按实际环境填入密钥与地址
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. 核心运行模式与本地存储（FastAPI 后端 & PDF Worker 共用 / SQLite）
# ------------------------------------------------------------------------------
# 运行环境标识（如 development / production）
RAG_ENV=development

# 外部服务适配模式：
# - local：本地离线开发/测试模式（不依赖真实外部服务，使用确定性占位向量与本地模拟回答）
# - real ：真实链路模式（启用 Kafka、Elasticsearch、MinerU、DeepSeek 与 BGE 向量模型）
RAG_ADAPTER_MODE=local

# SQLite 数据库文件路径（首次启动会自动初始化表结构）
RAG_DATABASE_PATH=data/rag.sqlite3

# 本地文件存储根目录（存放上传的原始 PDF、MinerU 解析产物及对话图片附件）
RAG_STORAGE_PATH=data/storage


# ------------------------------------------------------------------------------
# 2. FastAPI Web 后端服务（接口鉴权、限流与文件上传限制）
# ------------------------------------------------------------------------------
# 接口访问密钥：留空则不启用鉴权；设置后除 /api/v1/health 外请求需携带请求头 X-API-Key
RAG_API_KEY=

# 单客户端 IP 每分钟最大 API 请求次数（代码默认值为 300）
RAG_RATE_LIMIT_PER_MINUTE=60

# 单次上传接口允许同时上传的最大 PDF 文件数
RAG_MAX_UPLOAD_FILES=10

# 单个 PDF 文件允许的最大字节数（默认 104857600 = 100 MiB）
RAG_MAX_UPLOAD_BYTES=104857600


# ------------------------------------------------------------------------------
# 3. PDF 解析 Worker 进程（python -m app.worker.executor）
# ------------------------------------------------------------------------------
# 当前 Worker 节点唯一标识，用于 SQLite 解析任务租约（lease）归属标记
RAG_WORKER_ID=local-worker

# 单个 Worker 进程最大并发处理的 PDF 解析任务数
RAG_WORKER_CONCURRENCY=2


# ------------------------------------------------------------------------------
# 4. Kafka 消息队列与 Outbox 事件投递（real 模式下启用）
#    - FastAPI 内置 OutboxDispatcher 负责发布事件
#    - Worker 内置 KafkaTaskConsumer 负责消费通知
# ------------------------------------------------------------------------------
# Kafka Broker 连接地址（本地常见如 localhost:9092 或 127.0.0.1:9092）
RAG_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# PDF 解析请求事件投递的 Kafka Topic 名称
RAG_KAFKA_TOPIC=rag.pdf.parse.requested

# Worker 消费 Kafka 解析事件时使用的 Consumer Group ID
RAG_KAFKA_CONSUMER_GROUP=rag-pdf-parser-group

# OutboxDispatcher 空闲时轮询 SQLite 待发送事件的间隔（秒）
RAG_OUTBOX_POLL_SECONDS=2.0

# Outbox 事件发布锁的租约时长（秒），超时未完成将允许重新抢占投递
RAG_OUTBOX_LEASE_SECONDS=30


# ------------------------------------------------------------------------------
# 5. Elasticsearch 混合检索引擎（Worker 切片入库 & FastAPI 检索共用）
# ------------------------------------------------------------------------------
# Elasticsearch 服务地址（若本地 ES 8.x 开启了 HTTPS 安全层，需改为如 https://127.0.0.1:9200）
RAG_ELASTICSEARCH_URL=http://localhost:9200

# 知识库切片检索的索引/别名名称（系统内部会维护物理索引如 rag_chunks_v2 并绑定该别名）
RAG_ELASTICSEARCH_INDEX=rag_chunks

# 是否校验 Elasticsearch HTTPS 证书（本地自签名证书开发环境可设为 false，生产环境建议 true）
RAG_ELASTICSEARCH_VERIFY_CERTS=true

# 认证方式一：Basic Auth 用户名与密码
RAG_ELASTICSEARCH_USERNAME=elastic
RAG_ELASTICSEARCH_PASSWORD=

# 认证方式二：API Key（若非空则优先于用户名/密码认证，不使用请留空）
RAG_ELASTICSEARCH_API_KEY=


# ------------------------------------------------------------------------------
# 6. MinerU 文档解析服务（PDF Worker 调用 MinerU v4 API 提取图文与版面）
# ------------------------------------------------------------------------------
# MinerU v4 API 基础地址
RAG_MINERU_API_URL=https://mineru.net/api/v4

# MinerU API Token（real 模式下运行 Worker 必填，例如 sk-...）
RAG_MINERU_API_KEY=

# MinerU 解析模型版本（默认 vlm）
RAG_MINERU_MODEL_VERSION=vlm

# 轮询 MinerU 批量解析任务状态的间隔时间（秒）
RAG_MINERU_POLL_SECONDS=10

# 上传本地 PDF 至 MinerU 签名对象存储 URL 的超时时间（秒）
RAG_MINERU_UPLOAD_TIMEOUT_SECONDS=300


# ------------------------------------------------------------------------------
# 7. DeepSeek / OpenAI 兼容大模型服务（FastAPI 多轮问答与流式生成）
# ------------------------------------------------------------------------------
# 大模型 Chat Completions 接口地址（支持 OpenAI 兼容协议流式输出）
RAG_DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# DeepSeek（或兼容模型服务）API Key（real 模式下对话生成必填，例如 sk-...）
RAG_DEEPSEEK_API_KEY=

# 对话生成使用的模型名称（如 deepseek-chat、deepseek-flash 等）
RAG_DEEPSEEK_MODEL=deepseek-chat


# ------------------------------------------------------------------------------
# 8. Web 前端应用（可选，位于 web/ 目录，可在 web/.env 或终端环境中配置）
# ------------------------------------------------------------------------------
# Vite 本地开发服务器代理 /api 请求的后端地址（默认 http://127.0.0.1:8000）
# VITE_API_PROXY=http://127.0.0.1:8000

# 前端生产构建时的后端 API 基础 URL（同域反向代理部署时留空即可）
# VITE_API_BASE_URL=
