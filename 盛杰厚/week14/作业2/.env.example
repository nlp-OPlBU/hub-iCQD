# ─────────────────────────────────────────────────────────────────────────────
# 复制本文件为 .env 后按需修改（.env 已在 .gitignore 里，不会提交密钥）
#   cp .env.example .env
# 优先级：真实环境变量 > .env > config.py 里的默认值
# ─────────────────────────────────────────────────────────────────────────────

# ══ 大模型：阿里百炼（DashScope，OpenAI 兼容模式）══
# 【唯一必填项】不填也能跑通全链路，只是回答走 mock（用检索片段拼装，仍带图片 markdown）
# 申请地址：https://bailian.console.aliyun.com/  →  API-KEY 管理
DASHSCOPE_API_KEY=

# 服务地址（一般不用改）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 多模态模型：图 + 问 一起送它（用户传图、或检索到文档配图时启用）
LLM_MODEL=qwen3-vl-plus
# 纯文本问答模型：没有图时用它，更省 token
LLM_TEXT_MODEL=qwen-plus
LLM_MAX_TOKENS=1600
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120

# ══ Embedding：百炼 text-embedding-v4（默认）／ 本地 bge-small-zh-v1.5（可选）══
# openai = 百炼 text-embedding-v4（默认，1024 维，不加载 torch）；local = 本地 bge（离线，需 torch）；mock = 哈希向量（只调试）
EMBED_BACKEND=openai
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_DEVICE=auto
# 本地已有模型目录时填这里（留空则自动找 HF / ModelScope 缓存，都没有就联网下载 ~95MB）
# EMBED_MODEL_DIR=/Users/you/.cache/huggingface/hub/models--BAAI--bge-small-zh-v1.5/snapshots/xxx
# 国内网络下载模型可设： HF_ENDPOINT=https://hf-mirror.com
# 以下三项仅在 EMBED_BACKEND=openai 时生效；默认 BASE_URL 复用 LLM_BASE_URL、KEY 复用 DASHSCOPE_API_KEY
# EMBED_OPENAI_BASE_URL=
# EMBED_OPENAI_API_KEY=
# 向量模型（1024 维）；EMBED_OPENAI_BATCH 默认 10，是 DashScope 单批上限
EMBED_OPENAI_MODEL=text-embedding-v4

# 给文档里的每张图生成一段文字描述（描述参与向量检索 = 图片可被搜到）。需要 DASHSCOPE_API_KEY
IMAGE_CAPTION=1

# ══ Kafka ══
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# 1 = 用真实 Kafka（默认）。0 = 用进程内队列，只为在没有 broker 的机器上调试前端
USE_KAFKA=1
# Kafka 连不上时是否自动降级为进程内队列（/api/health 会如实显示当前后端）
ALLOW_LOCAL_FALLBACK=1
KAFKA_CREATE_TOPICS=1
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1

# ══ MinerU（PDF 解析）══
# 本地启动： pip install -U "mineru[core]" && mineru-api --host 127.0.0.1 --port 8002
# 起不来会自动用内置解析器（pdfplumber + pypdfium2），两者产出同一种中间结构
MINERU_BASE_URL=http://127.0.0.1:8002
MINERU_API_PATH=/file_parse
# pipeline（快、CPU 友好）| vlm-engine | hybrid-auto-engine（扫描件/复杂版式更好）
MINERU_BACKEND=pipeline
MINERU_PARSE_METHOD=auto
# auto = 优先异步 /tasks（能拿到真实解析进度喂给进度条），不支持就退回同步 /file_parse
MINERU_MODE=auto
MINERU_TIMEOUT=600
# 1 = 严格要求 MinerU，不可用就直接判「解析失败」；0 = 允许降级到内置解析器
MINERU_STRICT=0
# MINERU_TOKEN=

# ══ 检索与切块 ══
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.30
RETRIEVAL_MAX_IMAGES=4
CHUNK_SIZE=600
CHUNK_OVERLAP=80
QA_HISTORY_TURNS=3

# ══ Web ══
HOST=0.0.0.0
PORT=8010
MAX_UPLOAD_MB=80
# 1 = Web 进程内自带 parse/index/qa 三个消费者（一条命令跑全部，推荐先这样体验）
# 0 = Worker 由 python worker.py 单独进程跑（真正多进程部署，验证 Kafka 解耦时用）
WORKERS_INPROC=1

# ══ 数据目录（默认本目录下的 data/）══
# DATA_DIR=./data
