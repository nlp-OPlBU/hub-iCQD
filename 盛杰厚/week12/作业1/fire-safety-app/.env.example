# 复制本文件为 .env 并填入你自己的配置（.env 不会提交到 git）
# 模型服务 API Key（必填，除非 MOCK=1）
API_KEY=

# 模型服务地址（OpenAI 兼容接口，末尾不带 /）
# 参考案例中使用的是 openkey.cloud，也可换成其他兼容服务或 DeepSeek 官方网关
API_BASE_URL=https://api.deepseek.com

# 模型名称
MODEL_NAME=deepseek-flash

# 设为 1 时使用本地模拟结果（无需 API Key，用于调试前后端）
MOCK=0

# 模型调用超时秒数
TIMEOUT=60
