# 复制本文件为 .env 并填入自己的配置（.env 不会提交到 git）
# 模型服务 API Key（必填，除非 MOCK=1）
DEEPSEEK_API_KEY=

# 模型服务地址（OpenAI 兼容接口，末尾不带 /）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名称
DEEPSEEK_MODEL=deepseek-flash

# 数据库连接地址（默认使用本目录的 chinook.db）
# DB_URL=sqlite:///./chinook.db

# 设为 1 时不调用大模型，用本地规则模拟（无需 API Key，用于调试前后端）
MOCK=0

# SQL 校验/改写最多重试次数
MAX_RETRY=5
